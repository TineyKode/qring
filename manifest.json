{
  "manifest_version": 3,
  "name": "QRing",
  "version": "1.0.1",
  "description": "Turn any link, text, or image URL into a QR code. Right-click or use the popup, then copy or download.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QRing"
  },
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "Open QRing"
    }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
